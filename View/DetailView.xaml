<UserControl x:Class="Project_check_URL.View.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Project_check_URL.View"
             Background="{DynamicResource PageBackground}">

    <UserControl.Resources>

        <!-- ================= BACKGROUND (same as HomeView) ================= -->

        <LinearGradientBrush x:Key="PageBackground"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#071426" Offset="0"/>
            <GradientStop Color="#0B2740" Offset="0.55"/>
            <GradientStop Color="#071426" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassCardBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#1A3A56" Offset="0"/>
            <GradientStop Color="#122D45" Offset="1"/>
        </LinearGradientBrush>

        <!-- ================= SCROLLBAR (dark / slim) ================= -->

        <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumb"
                                Background="#2F6D93"
                                CornerRadius="4"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#4FA3D1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#72D7F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Border Background="#0A1D31"
                                    Opacity="0.55"
                                    CornerRadius="6"
                                    Margin="2"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollTrackButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollTrackButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Border Background="#0A1D31"
                                            Opacity="0.55"
                                            CornerRadius="6"
                                            Margin="2"/>
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource ScrollTrackButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource ScrollTrackButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= BACK BUTTON ================= -->

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#142B42"/>
            <Setter Property="Foreground" Value="#D9EAF7"/>
            <Setter Property="BorderBrush" Value="#294761"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="backBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="backBd" Property="Background" Value="#1D4563"/>
                                <Setter TargetName="backBd" Property="BorderBrush" Value="#08A9D6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="backBd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ONE DETAIL LINE (label : value) ================= -->
        <!-- A line without a value is a group heading.                         -->

        <DataTemplate x:Key="DetailLineTemplate" DataType="{x:Type local:DetailLine}">

            <Grid x:Name="Row" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LabelText"
                           Text="{Binding Label}"
                           Foreground="#6FA5C2"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="ValueText"
                           Grid.Column="1"
                           Text="{Binding Value}"
                           Foreground="#EAF5FF"
                           FontSize="12.5"
                           TextWrapping="Wrap"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter TargetName="Row" Property="Margin" Value="0,10,0,4"/>
                    <Setter TargetName="LabelText" Property="Grid.ColumnSpan" Value="2"/>
                    <Setter TargetName="LabelText" Property="Foreground" Value="#54D8FA"/>
                    <Setter TargetName="LabelText" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= ONE CHECK (card) ================= -->
        <!-- Collapsed: name + one-line finding + level.                    -->
        <!-- Selected : card lifts, glows and shows everything inside.       -->

        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type local:DetailEntry}">

            <Border x:Name="Card"
                    Margin="0,0,0,8"
                    CornerRadius="12"
                    Background="#0F2740"
                    BorderBrush="#1F4260"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>

                <StackPanel>

                    <!-- Header row (always visible, clickable) -->

                    <Border x:Name="HeaderRow"
                            Background="Transparent"
                            Padding="14,12,16,12"
                            Cursor="Hand"
                            MouseLeftButtonUp="Entry_Click">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="LevelBar"
                                    Grid.Column="0"
                                    Width="4"
                                    CornerRadius="2"
                                    Margin="0,0,14,0"
                                    Background="#2FBF8A"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Criterion}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock x:Name="FindingPreview"
                                       Grid.Column="2"
                                       Text="{Binding Finding}"
                                       Foreground="#A9C2D5"
                                       FontSize="12.5"
                                       Margin="8,0,14,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <Border x:Name="LevelBadge"
                                    Grid.Column="3"
                                    CornerRadius="7"
                                    Padding="10,4"
                                    Background="#174B3D"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="LevelText"
                                           Text="{Binding Level}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#72E5B1"/>
                            </Border>

                            <TextBlock x:Name="Chevron"
                                       Grid.Column="4"
                                       Text="▸"
                                       Foreground="#6FA5C2"
                                       FontSize="14"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Full content (only when selected) -->

                    <Border x:Name="DetailPanel"
                            Visibility="Collapsed"
                            Padding="32,0,18,18">

                        <StackPanel>

                            <Border Height="1"
                                    Background="#244A68"
                                    Margin="0,0,0,14"/>

                            <TextBlock Text="FINDING"
                                       Foreground="#6FA5C2"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding Finding}"
                                       Foreground="#EAF5FF"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <StackPanel x:Name="DetailsBox" Margin="0,0,0,14">

                                <TextBlock Text="DETAILS"
                                           Foreground="#6FA5C2"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6"/>

                                <Border Background="#0B1F33"
                                        BorderBrush="#1F4260"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,10,12,8">

                                    <ItemsControl ItemsSource="{Binding Details}"
                                                  ItemTemplate="{StaticResource DetailLineTemplate}"
                                                  Focusable="False"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="ABOUT THIS CHECK"
                                       Foreground="#6FA5C2"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding About}"
                                       Foreground="#A9C2D5"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <Border x:Name="AdviceBox"
                                    CornerRadius="9"
                                    Padding="12,10"
                                    Background="#10352F">

                                <StackPanel>
                                    <TextBlock x:Name="AdviceLabel"
                                               Text="ASSESSMENT"
                                               Foreground="#72E5B1"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{Binding Advice}"
                                               Foreground="#EAF5FF"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <DataTemplate.Triggers>

                <!-- hover (not selected) -->

                <Trigger SourceName="HeaderRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#12304A"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#2F6F95"/>
                </Trigger>

                <!-- nothing to show in DETAILS -->

                <DataTrigger Binding="{Binding HasDetails}" Value="False">
                    <Setter TargetName="DetailsBox" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- level colours -->

                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="LevelBar" Property="Background" Value="#E8B04A"/>
                    <Setter TargetName="LevelBadge" Property="Background" Value="#59451D"/>
                    <Setter TargetName="LevelText" Property="Foreground" Value="#F5C76B"/>
                    <Setter TargetName="AdviceBox" Property="Background" Value="#352B14"/>
                    <Setter TargetName="AdviceLabel" Property="Foreground" Value="#F5C76B"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Level}" Value="Danger">
                    <Setter TargetName="LevelBar" Property="Background" Value="#E5566B"/>
                    <Setter TargetName="LevelBadge" Property="Background" Value="#5B2932"/>
                    <Setter TargetName="LevelText" Property="Foreground" Value="#FF8C9B"/>
                    <Setter TargetName="AdviceBox" Property="Background" Value="#3A1A22"/>
                    <Setter TargetName="AdviceLabel" Property="Foreground" Value="#FF8C9B"/>
                </DataTrigger>

                <!-- another card is selected: fade this one -->

                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDimmed}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, ElementName=HeaderRow}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="Opacity" Value="0.9"/>
                </MultiDataTrigger>

                <!-- this card is selected: lift + glow + full content -->

                <DataTrigger Binding="{Binding IsSelected}" Value="True">

                    <Setter TargetName="DetailPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FindingPreview" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Chevron" Property="Text" Value="▾"/>
                    <Setter TargetName="Chevron" Property="Foreground" Value="#54D8FA"/>
                    <Setter TargetName="Card" Property="Background" Value="#14344F"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#08A9D6"/>
                    <Setter TargetName="Card" Property="Margin" Value="0,6,0,16"/>
                    <Setter TargetName="Card" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#08A9D6"
                                              Opacity="0.35"
                                              BlurRadius="22"
                                              ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>

                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.012" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.012" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="DetailPanel"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>

                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>

                </DataTrigger>

            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= ONE SECTION (group of checks) ================= -->

        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:DetailSection}">

            <Border Background="{StaticResource GlassCardBrush}"
                    BorderBrush="#28516D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,18,20,12"
                    Margin="0,0,0,20">

                <StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="36"
                                Height="36"
                                CornerRadius="11"
                                Background="#103D58"
                                BorderBrush="#08A9D6"
                                BorderThickness="1"
                                VerticalAlignment="Center">

                            <TextBlock Text="{Binding Number}"
                                       Foreground="#54D8FA"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="14,0,12,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Subtitle}"
                                       Foreground="#6FA5C2"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border x:Name="SummaryBadge"
                                Grid.Column="2"
                                CornerRadius="8"
                                Padding="11,5"
                                Background="#1A3550"
                                VerticalAlignment="Center">

                            <TextBlock x:Name="SummaryText"
                                       Text="{Binding Summary}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#A9C2D5"/>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Entries}"
                                  ItemTemplate="{StaticResource EntryTemplate}"
                                  Focusable="False"/>

                    <TextBlock x:Name="EmptyNote"
                               Text="{Binding EmptyText}"
                               Visibility="Collapsed"
                               Foreground="#6FA5C2"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                </StackPanel>
            </Border>

            <DataTemplate.Triggers>

                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="EmptyNote" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Level}" Value="Safe">
                    <Setter TargetName="SummaryBadge" Property="Background" Value="#174B3D"/>
                    <Setter TargetName="SummaryText" Property="Foreground" Value="#72E5B1"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="SummaryBadge" Property="Background" Value="#59451D"/>
                    <Setter TargetName="SummaryText" Property="Foreground" Value="#F5C76B"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Level}" Value="Danger">
                    <Setter TargetName="SummaryBadge" Property="Background" Value="#5B2932"/>
                    <Setter TargetName="SummaryText" Property="Foreground" Value="#FF8C9B"/>
                </DataTrigger>

            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel>

        <!-- ================= TOP BAR ================= -->

        <Border DockPanel.Dock="Top"
                Background="#0A1B2D"
                BorderBrush="#1C3B55"
                BorderThickness="0,0,0,1"
                Padding="20,10">

            <DockPanel>

                <Button DockPanel.Dock="Left"
                        Style="{StaticResource BackButtonStyle}"
                        Click="Back_Click"
                        ToolTip="Back to home">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←"
                                   FontSize="16"
                                   Margin="0,-2,8,0"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>

                <StackPanel Margin="16,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Detailed result"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="LINKGUARD · URL SECURITY ANALYZER"
                               Foreground="#6FA5C2"
                               FontSize="9"
                               FontWeight="SemiBold"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================= CONTENT ================= -->

        <ScrollViewer x:Name="PageScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="32,24,32,28"
                        MaxWidth="1000">

                <!-- URL + totals -->

                <Border Background="{StaticResource GlassCardBrush}"
                        BorderBrush="#28516D"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20,16"
                        Margin="0,0,0,12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="CHECKED URL"
                                       Foreground="#6FA5C2"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="UrlText"
                                       Foreground="#EAF5FF"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <Border Background="#174B3D" CornerRadius="8" Padding="10,5" Margin="0,0,6,0">
                                <TextBlock x:Name="SafeCount" Foreground="#72E5B1" FontSize="11.5" FontWeight="Bold"/>
                            </Border>

                            <Border Background="#59451D" CornerRadius="8" Padding="10,5" Margin="0,0,6,0">
                                <TextBlock x:Name="WarnCount" Foreground="#F5C76B" FontSize="11.5" FontWeight="Bold"/>
                            </Border>

                            <Border Background="#5B2932" CornerRadius="8" Padding="10,5">
                                <TextBlock x:Name="DangerCount" Foreground="#FF8C9B" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Click a check to focus it and see everything inside. Click it again to close."
                           Foreground="#6FA5C2"
                           FontSize="12"
                           Margin="4,0,0,14"/>

                <!-- three sections -->

                <ItemsControl x:Name="SectionList"
                              ItemTemplate="{StaticResource SectionTemplate}"
                              Focusable="False"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>