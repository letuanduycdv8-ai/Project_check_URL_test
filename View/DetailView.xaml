<UserControl x:Class="Project_check_URL.View.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="16,10">
            <DockPanel>
                <Button Height="30" Width="30"  DockPanel.Dock="Left"
                         Click="Back_Click">
                    <Image Height="30" Width="30" Source="F:\C#\Project_check_URL\Picture\back_icon.png"/>
                </Button>
                <TextBlock Text="Detailed result" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" MaxWidth="900">
                <TextBlock x:Name="UrlText" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                <DataGrid x:Name="DetailGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Criterion" Binding="{Binding Criterion}" Width="2*"/>
                        <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="3*"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

               
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>