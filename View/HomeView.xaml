<UserControl x:Class="Project_check_URL.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             Background="#071426">

    <UserControl.Resources>

        <!-- ================= BACKGROUND ================= -->

        <LinearGradientBrush x:Key="PageBackground"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#071426" Offset="0"/>
            <GradientStop Color="#0B2740" Offset="0.55"/>
            <GradientStop Color="#071426" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glass panels -->
        <LinearGradientBrush x:Key="GlassCardBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#1A3A56" Offset="0"/>
            <GradientStop Color="#122D45" Offset="1"/>
        </LinearGradientBrush>

        <!-- ================= SCROLLBAR (dark / slim) ================= -->

        <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumb"
                                Background="#2F6D93"
                                CornerRadius="4"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#4FA3D1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#72D7F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Border Background="#0A1D31"
                                    Opacity="0.55"
                                    CornerRadius="6"
                                    Margin="2"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollTrackButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollTrackButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Border Background="#0A1D31"
                                            Opacity="0.55"
                                            CornerRadius="6"
                                            Margin="2"/>
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource ScrollTrackButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource ScrollTrackButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= PRIMARY BUTTON ================= -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd"
                                Background="#08A9D6"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  ShadowDepth="2"
                                                  Opacity="0.22"
                                                  Color="#00BCEB"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#16BDE8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= HEADER MENU ================= -->
        <Style x:Key="HeaderMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EAF5FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>

            <Style.Triggers>
                
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#193D5B"/>
                    <Setter Property="Foreground" Value="#5EDBFF"/>
                </Trigger>

                
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Foreground" Value="#0B1F33"/>
                </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Role" Value="SubmenuItem"/>
                        <Condition Property="IsHighlighted" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="#0B1F33"/>
                    <Setter Property="Background" Value="#CFE8F7"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= QUICK ACTION BUTTON ================= -->

        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="#142B42"/>
            <Setter Property="Foreground" Value="#D9EAF7"/>
            <Setter Property="BorderBrush" Value="#294761"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="4000"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="actionBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="actionBd"
                                        Property="Background"
                                        Value="#1D4563"/>
                                <Setter TargetName="actionBd"
                                        Property="BorderBrush"
                                        Value="#08A9D6"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="actionBd"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ONLINE TOGGLE ================= -->

        <Style x:Key="OnlineToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <Border x:Name="bd"
                                Background="#64748B"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="White"
                                         Margin="0,0,7,0"/>

                                <ContentPresenter VerticalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#078B72"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd"
                                        Property="Opacity"
                                        Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= STAGE TEXT ================= -->

        <Style x:Key="StageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAF5FF"/>
        </Style>

        <Style x:Key="StageDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9DB7C9"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

    </UserControl.Resources>

    <!-- ====================================================== -->
    <!-- MAIN WINDOW                                            -->
    <!-- ====================================================== -->

    <Grid Background="{StaticResource PageBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================== -->
        <!-- TOP BAR                                            -->
        <!-- ================================================== -->

        <Border Grid.Row="0"
                Background="#0A1B2D"
                BorderBrush="#1C3B55"
                BorderThickness="0,0,0,1"
                Padding="20,6">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO -->

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="30"
                            Height="30"
                            CornerRadius="9"
                            Background="#103D58"
                            BorderBrush="#08A9D6"
                            BorderThickness="1">

                        <TextBlock Text="◆"
                                   Foreground="#54D8FA"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="LINKGUARD"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="URL SECURITY ANALYZER"
                                   Foreground="#6FA5C2"
                                   FontSize="8"
                                   FontWeight="SemiBold"/>

                    </StackPanel>
                </StackPanel>

                <!-- MENU -->

                <Menu Grid.Row="0"
                      Grid.Column="1"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      Foreground="Black">

                    <Menu.Resources>
                        <Style TargetType="MenuItem"
                               BasedOn="{StaticResource HeaderMenuItemStyle}"/>
                    </Menu.Resources>

                    <MenuItem Header="_File">
                        <MenuItem Header="_Export report" Click="Export_Click"/>
                        <MenuItem Header="Clear" Click="ClearButton_Click"/>
                        <Separator/>
                        <MenuItem Header="_Sign out"/>
                    </MenuItem>

                    <MenuItem Header="_View">
                        <MenuItem Header="_Information more about URL" Click="Show_information"/>
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="_About"/>
                    </MenuItem>

                </Menu>

                <!-- TOOLBAR -->

                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        Padding="5,3"
                        CornerRadius="10"
                        Background="#0D2439"
                        BorderBrush="#193B55"
                        BorderThickness="1">

                    <DockPanel LastChildFill="False">

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left">


                            <Button Style="{StaticResource QuickActionButton}"
                                    ToolTip="Clear the result"
                                    Click="ClearButton_Click"
                                    MouseEnter="Tool_Enter"
                                    MouseLeave="Leave"
                                    Tag="Clear the result, you can add new URL">

                                <Image Source="/Picture/Clean.png"  Height="20" Width="Auto"/>

                            </Button>

                            <Button Style="{StaticResource QuickActionButton}"
                                    ToolTip="Export report"
                                    Click="Export_Click"
                                    MouseEnter="Tool_Enter"
                                    MouseLeave="Leave"
                                    Tag="Export the full result">

                                <Image Source="/Picture/Export.png"  Height="20" Width="Auto"/>

                            </Button>


                            <Button Style="{StaticResource QuickActionButton}"
                                    ToolTip="More information"
                                    Click="Show_information"
                                    MouseEnter="Tool_Enter"
                                    MouseLeave="Leave"
                                    Tag="Show more information about us">

                                <Image Source="/Picture/information Icon.png" Height="20" Width="Auto"/>

                            </Button>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Right"
                                   Text="PROTECTED WORKSPACE"
                                   Foreground="#5D8CA9"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="14,0,8,0"/>

                        <!-- ====================================== -->
                        <!-- TOOLBAR IMAGE SLOT                    -->
                        <!-- ====================================== -->

                        <Grid DockPanel.Dock="Right"
                              Height="26"
                              MinWidth="26"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center">

                            <Rectangle Stroke="#3A6A8C"
                                       StrokeDashArray="3 2"
                                       StrokeThickness="1"
                                       RadiusX="6"
                                       RadiusY="6"/>

                            <Image x:Name="ToolbarImage"
                                   Margin="2"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="/Picture/app_icon.png"/>

                        </Grid>

                    </DockPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ================================================== -->
        <!-- MAIN CONTENT AREA                                  -->
        <!-- ================================================== -->

        <Grid Grid.Row="1" ClipToBounds="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>



            <Border 
                    IsHitTestVisible="False">

                <Border.Background>
                    <ImageBrush ImageSource="/Picture/homeground.jpg"
                                Stretch="UniformToFill"
                                Opacity="0.30"/>
                </Border.Background>

            </Border>

            <!-- DARK GRADIENT OVERLAY -->

            <Border 
                    IsHitTestVisible="False">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">

                        <GradientStop Color="#E6071426"
                                      Offset="0"/>

                        <GradientStop Color="#D9103B56"
                                      Offset="0.52"/>

                        <GradientStop Color="#E608182A"
                                      Offset="1"/>

                    </LinearGradientBrush>
                </Border.Background>

            </Border>

            <!-- DECORATIVE LIGHT EFFECTS -->

            <Border 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="420"
                    Height="420"
                    Margin="-180,-170,0,0"
                    CornerRadius="210"
                    IsHitTestVisible="False">

                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#173F5B" Offset="0"/>
                        <GradientStop Color="#00173F5B" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

            </Border>

            <Border 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="500"
                    Height="500"
                    Margin="0,-220,-190,0"
                    CornerRadius="250"
                    IsHitTestVisible="False">

                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#124B67" Offset="0"/>
                        <GradientStop Color="#00124B67" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

            </Border>

            <!-- ================================================== -->
            <!-- RESULT + OVERVIEW SCROLL AREA                      -->
            <!-- ================================================== -->

            <ScrollViewer x:Name="PageScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="30,4,30,14"
                            MaxWidth="1200"
                            HorizontalAlignment="Stretch">

                    <!-- ============================================== -->
                    <!-- HERO + URL SEARCH                              -->
                    <!-- ============================================== -->

                    <StackPanel x:Name="SearchSection"
                            Margin="0,14,0,18"
                            HorizontalAlignment="Stretch">

                        <!-- HERO TEXT -->

                        <StackPanel x:Name="HeroText"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">

                            <TextBlock Text="CHECK BEFORE YOU CLICK"
                                   Foreground="#50D5F5"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                            <TextBlock Text="Know what's behind every link."
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0"/>

                            <TextBlock Text="Analyze suspicious URLs with offline intelligence and online security checks."
                                   Foreground="#A9C2D5"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        </StackPanel>

                        <!-- URL SEARCH CARD -->

                        <Border Background="{StaticResource GlassCardBrush}"
                            CornerRadius="16"
                            Padding="22,14"
                            HorizontalAlignment="Stretch"
                            BorderBrush="#2C5C7E"
                            BorderThickness="1">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="6"
                                              Opacity="0.3"
                                              Color="#000000"/>
                            </Border.Effect>

                            <StackPanel>

                                <TextBlock Text="Enter a URL to inspect"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#D9EAF7"
                                       Margin="2,0,0,8"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                        Background="#0B1E31"
                                        BorderBrush="#2A5272"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="13,0"
                                        Height="42">

                                        <DockPanel>

                                            <TextBlock Text="⌕"
                                                   FontSize="20"
                                                   Foreground="#6FA5C2"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,9,0"/>

                                            <TextBox x:Name="LinkTextBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="14"
                                                 Foreground="#EAF5FF"
                                                 CaretBrush="#EAF5FF"
                                                 SelectionBrush="#08A9D6"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0"
                                                 ToolTip="Paste the URL here"/>

                                        </DockPanel>
                                    </Border>

                                    <Button x:Name="CheckButton"
                                        Grid.Column="1"
                                        Content="Scan URL  →"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        IsDefault="True"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="CheckButton_Click"/>

                                </Grid>

                                <!-- ONLINE STATUS -->

                                <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="2,10,0,0">

                                    <ToggleButton x:Name="OnlineToggle"
                                              Style="{StaticResource OnlineToggleStyle}"
                                              Content="Checking..."
                                              IsChecked="False"
                                              IsHitTestVisible="False"
                                              Checked="OnlineToggle_Changed"
                                              Unchecked="OnlineToggle_Changed"/>

                                    <Ellipse x:Name="CheckingSpinner"
                                         Width="14"
                                         Height="14"
                                         Margin="10,0,0,0"
                                         Stroke="#08A9D6"
                                         StrokeThickness="2"
                                         StrokeDashArray="3 2"
                                         RenderTransformOrigin="0.5,0.5"
                                         VerticalAlignment="Center">

                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate"/>
                                        </Ellipse.RenderTransform>

                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                        Storyboard.TargetName="SpinnerRotate"
                                                        Storyboard.TargetProperty="Angle"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>

                                    </Ellipse>

                                    <TextBlock Text="Offline checks are always available"
                                           Foreground="#8FB0C6"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>

                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- EMPTY HINT -->

                        <TextBlock x:Name="EmptyHint"
                               Margin="0,10,0,0"
                               Text="Paste a link above and select Scan URL to view its security assessment."
                               Foreground="#B5C9D8"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    </StackPanel>



                    <!-- ========================================== -->
                    <!-- RESULT PANEL - NEW DARK DESIGN             -->
                    <!-- ========================================== -->

                    <StackPanel x:Name="ResultPanel"
                                Margin="0,0,0,18"
                                Visibility="Collapsed">

                        <!-- MAIN VERDICT CARD -->

                        <Border Background="#102B43"
                                BorderBrush="#286080"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0,0,0,14">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="3"
                                                  Opacity="0.22"
                                                  Color="#000000"/>
                            </Border.Effect>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- VERDICT -->

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="SECURITY ASSESSMENT"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#6FA5C2"/>

                                    <TextBlock x:Name="VerdictText"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Margin="0,7,0,0"
                                               Foreground="#5FD99B"/>

                                    <TextBlock x:Name="CheckedUrlText"
                                               Foreground="#A9C2D5"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,7,15,0"/>

                                </StackPanel>

                                <!-- ASSESSMENT BY STEP -->

                                <Border Grid.Column="1"
                                        Background="#0B2033"
                                        BorderBrush="#28516D"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="18,12"
                                        MinWidth="270">

                                    <StackPanel VerticalAlignment="Center">

                                        <TextBlock Text="RESULT BY STEP"
                                                   Foreground="#82A8C0"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Offline"
                                                       Foreground="#A9C2D5" FontSize="12" Margin="0,0,16,6"/>
                                            <TextBlock x:Name="StepOfflineText" Grid.Row="0" Grid.Column="1"
                                                       FontSize="12" FontWeight="Bold" Foreground="#668BA4"
                                                       HorizontalAlignment="Right" Text="-"/>       

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Online"
                                                       Foreground="#A9C2D5" FontSize="12" Margin="0,0,16,6"/>
                                            <TextBlock x:Name="StepOnlineText" Grid.Row="1" Grid.Column="1"
                                                       FontSize="12" FontWeight="Bold" Foreground="#668BA4"
                                                       HorizontalAlignment="Right" Text="-"/>           

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="VirusTotal"
                                                       Foreground="#A9C2D5" FontSize="12" Margin="0,0,16,0"/>
                                            <TextBlock x:Name="StepVtText" Grid.Row="2" Grid.Column="1"
                                                       FontSize="12" FontWeight="Bold" Foreground="#668BA4"
                                                       HorizontalAlignment="Right" Text="-"/>       
                                        </Grid>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- RESULT DETAILS TABLE -->

                        <Border Background="#102B43"
                                BorderBrush="#28516D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="2"
                                                  Opacity="0.2"
                                                  Color="#000000"/>
                            </Border.Effect>

                            <DataGrid x:Name="ResultGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserResizeRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#29465D"
                                      VerticalGridLinesBrush="Transparent"
                                      BorderThickness="0"
                                      Background="#102B43"
                                      Foreground="#D9EAF7"
                                      RowBackground="#102B43"
                                      AlternatingRowBackground="#15344E"
                                      AlternationCount="2"
                                      RowHeight="43"
                                      ColumnHeaderHeight="40"
                                      FontSize="12"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="ResultGrid_PreviewMouseWheel">

                                <DataGrid.Resources>

                                    <!-- TABLE HEADER -->

                                    <Style TargetType="{x:Type DataGridColumnHeader}">

                                        <Setter Property="Background"
                                                Value="#173B57"/>

                                        <Setter Property="Foreground"
                                                Value="#72D7F5"/>

                                        <Setter Property="FontWeight"
                                                Value="Bold"/>

                                        <Setter Property="FontSize"
                                                Value="11"/>

                                        <Setter Property="Padding"
                                                Value="12,8"/>

                                        <Setter Property="BorderThickness"
                                                Value="0,0,0,1"/>

                                        <Setter Property="BorderBrush"
                                                Value="#315873"/>

                                        <Setter Property="HorizontalContentAlignment"
                                                Value="Left"/>

                                        <Setter Property="VerticalContentAlignment"
                                                Value="Center"/>

                                    </Style>

                                    <!-- TABLE ROW -->

                                    <Style TargetType="{x:Type DataGridRow}">

                                        <Setter Property="Foreground"
                                                Value="#D9EAF7"/>

                                        <Setter Property="Background"
                                                Value="#102B43"/>

                                        <Setter Property="BorderThickness"
                                                Value="0"/>

                                        <Setter Property="VerticalContentAlignment"
                                                Value="Center"/>

                                        <Style.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter Property="Background"
                                                        Value="#1C4563"/>

                                            </Trigger>

                                            <Trigger Property="IsSelected"
                                                     Value="True">

                                                <Setter Property="Background"
                                                        Value="#20516D"/>

                                                <Setter Property="Foreground"
                                                        Value="White"/>

                                            </Trigger>

                                        </Style.Triggers>
                                    </Style>

                                    <!-- TABLE CELL -->

                                    <Style TargetType="{x:Type DataGridCell}">

                                        <Setter Property="Foreground"
                                                Value="#D9EAF7"/>

                                        <Setter Property="Background"
                                                Value="Transparent"/>

                                        <Setter Property="BorderThickness"
                                                Value="0"/>

                                        <Setter Property="Padding"
                                                Value="10,4"/>

                                        <Setter Property="VerticalContentAlignment"
                                                Value="Center"/>

                                    </Style>

                                    <!-- TEXT INSIDE TABLE -->

                                    <Style TargetType="{x:Type TextBlock}">

                                        <Setter Property="Foreground"
                                                Value="#D9EAF7"/>

                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>

                                        <Setter Property="TextTrimming"
                                                Value="CharacterEllipsis"/>

                                    </Style>

                                </DataGrid.Resources>

                                <!-- TABLE COLUMNS -->

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="CRITERION"
                                        Binding="{Binding Criterion}"
                                        Width="2*"/>

                                    <DataGridTextColumn
                                        Header="FINDING"
                                        Binding="{Binding Finding}"
                                        Width="3*"/>

                                    <DataGridTemplateColumn
                                        Header="LEVEL"
                                        Width="110">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Border CornerRadius="7"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">

                                                    <Border.Style>

                                                        <Style TargetType="{x:Type Border}">

                                                            <Setter Property="Background"
                                                                    Value="#174B3D"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding Level}"
                                                                             Value="Warning">

                                                                    <Setter Property="Background"
                                                                            Value="#59451D"/>

                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding Level}"
                                                                             Value="Danger">

                                                                    <Setter Property="Background"
                                                                            Value="#5B2932"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </Border.Style>

                                                    <TextBlock Text="{Binding Level}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#72E5B1"/>

                                                </Border>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>

                        <!-- FULL RESULT BUTTON -->

                        <Button Content="View Full Security Report  →"
                                Width="270"
                                Height="42"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource PrimaryButton}"
                                Click="Show_result"/>

                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- PIPELINE OVERVIEW - ORIGINAL DESIGN        -->
                    <!-- ========================================== -->

                    <Border x:Name="PipelineOverview"
                            Background="#0F2A42"
                            BorderBrush="#1F4561"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,14"
                            Margin="0,4,0,0">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="3"
                                              Opacity="0.3"
                                              Color="#000000"/>
                        </Border.Effect>

                        <StackPanel>

                            <DockPanel Margin="0,0,0,8">

                                <TextBlock DockPanel.Dock="Left"
                                           Text="How the assessment works"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Offline checks always run locally. Online checks are added when a connection is available."
                                           Foreground="#8FB0C6"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"/>

                            </DockPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ================================== -->
                                <!-- OFFLINE CARD                       -->
                                <!-- ================================== -->

                                <Border Grid.Column="0"
                                        Background="#0E2E3B"
                                        BorderBrush="#1E5A55"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,12">

                                    <StackPanel>

                                        <TextBlock Text="Offline"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#5FD99B"/>

                                        <TextBlock Text="Runs on this machine, no internet needed"
                                                   FontSize="11"
                                                   Foreground="#8CC7AE"
                                                   Margin="0,1,0,9"/>

                                        <!-- URL STRUCTURE -->

                                        <Border BorderBrush="#3FBF7F"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="URL structure"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Scheme, port, IP host, '@', punycode, shorteners. Internal addresses stop the scan."/>

                                            </StackPanel>
                                        </Border>

                                        <!-- LOOK-ALIKE DOMAINS -->

                                        <Border BorderBrush="#3FBF7F"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="Look-alike domains"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Detect homograph tricks and brand imitations in the domain name."/>

                                            </StackPanel>
                                        </Border>

                                        <!-- LOCAL BLOCKLIST -->

                                        <Border BorderBrush="#3FBF7F"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="Local blocklist"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Compare the domain with a blocklist snapshot stored on this machine."/>

                                            </StackPanel>
                                        </Border>

                                        <!-- RISK SCORE -->

                                        <Border BorderBrush="#3FBF7F"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0">

                                            <StackPanel>

                                                <TextBlock Text="Risk score"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Combine findings into one score: Safe, Suspicious or Dangerous."/>

                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>

                                <!-- ================================== -->
                                <!-- ONLINE CARD                        -->
                                <!-- ================================== -->

                                <Border x:Name="OnlineCard"
                                        Grid.Column="2"
                                        Background="#102A4B"
                                        BorderBrush="#25508A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,12">

                                    <StackPanel>

                                        <TextBlock Text="Online"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#6EA8FF"/>

                                        <TextBlock Text="Added only when an internet connection is available"
                                                   FontSize="11"
                                                   Foreground="#8FB0DA"
                                                   Margin="0,1,0,9"/>

                                        <!-- EXTERNAL LOOKUP -->

                                        <Border BorderBrush="#4C8DFF"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="External lookup"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Domain age (RDAP), DNS, IP reputation and public blocklists."/>

                                            </StackPanel>
                                        </Border>

                                        <!-- LIVE CONNECTION -->

                                        <Border BorderBrush="#4C8DFF"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="Live connection"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Guarded connection: SSL certificate, redirect chain and response headers."/>

                                            </StackPanel>
                                        </Border>

                                        <!-- HTML ANALYSIS -->

                                        <Border BorderBrush="#4C8DFF"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0"
                                                Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock Text="HTML analysis"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Page read as plain text, never executed: forms, hidden links, scripts."/>

                                            </StackPanel>
                                        </Border>

                                        <!-- SAVED FOR LATER -->

                                        <Border BorderBrush="#4C8DFF"
                                                BorderThickness="3,0,0,0"
                                                Padding="9,0,0,0">

                                            <StackPanel>

                                                <TextBlock Text="Saved for later"
                                                           Style="{StaticResource StageTitle}"/>

                                                <TextBlock Style="{StaticResource StageDesc}"
                                                           Text="Online findings are saved locally for offline reference."/>

                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ================================================== -->
        <!-- FOOTER                                             -->
        <!-- ================================================== -->

        <Border Grid.Row="2"
                Background="#071321"
                BorderBrush="#1A344A"
                BorderThickness="0,1,0,0"
                Padding="22,6">

            <DockPanel>

                <TextBlock Text="LINKGUARD  •  URL SECURITY ANALYZER"
                           Foreground="#64869D"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="#A8C4D5"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"/>

            </DockPanel>
        </Border>

    </Grid>

</UserControl>