<UserControl x:Class="Project_check_URL.View.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Project_check_URL"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="720">

    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#2F6BFF" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F55D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>

                    <DoubleAnimation Storyboard.TargetName="BackgroundPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.8"/>


                    <local:GridLengthAnimation Storyboard.TargetName="LeftCol"
                                               Storyboard.TargetProperty="Width"
                                               From="1*" To="0.6*"
                                               BeginTime="0:0:1.5" Duration="0:0:1.6">
                        <local:GridLengthAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </local:GridLengthAnimation.EasingFunction>
                    </local:GridLengthAnimation>

                    <local:GridLengthAnimation Storyboard.TargetName="RightCol"
                                               Storyboard.TargetProperty="Width"
                                               From="0*" To="0.4*"
                                               BeginTime="0:0:1.5" Duration="0:0:1.6">
                        <local:GridLengthAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </local:GridLengthAnimation.EasingFunction>
                    </local:GridLengthAnimation>


                    <DoubleAnimation Storyboard.TargetName="LoginCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     BeginTime="0:0:2.5" Duration="0:0:0.7"/>
                    <DoubleAnimation Storyboard.TargetName="LoginCard"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="40" To="0"
                                     BeginTime="0:0:2.5" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>


                    <DoubleAnimation Storyboard.TargetName="SloganText"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     BeginTime="0:0:3.3" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="SloganText"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="14" To="0"
                                     BeginTime="0:0:3.3" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="BackgroundPanel" Opacity="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="1*"/>
            <ColumnDefinition x:Name="RightCol" Width="0*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" ClipToBounds="True">
            <Viewbox Stretch="UniformToFill">
                <Grid Width="1280" Height="720">
                    <Image Source="\Picture\back.png" Stretch="Fill"/>

                    <TextBlock x:Name="SloganText"
                       Text="Security check before access to an URL"
                       Foreground="White" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap" Width="460"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="46,238,0,0"
                       Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="14"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Viewbox>

            <Border x:Name="GradientOverlay" VerticalAlignment="Bottom" Height="140">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

        </Grid>


        <Grid Grid.Column="1" Background="#F5F6FA" ClipToBounds="True">
            <Border x:Name="LoginCard"
                    MaxWidth="340" Margin="32,0,32,0"
                    VerticalAlignment="Center"
                    Padding="28" Background="White" CornerRadius="12"
                    Opacity="0"
                    MinHeight="200"
                    MinWidth="150">
                <Border.RenderTransform>
                    <TranslateTransform X="40"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Welcome to URL Check"
                               FontSize="20" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Account" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox" Height="34" Padding="6,0"
                             VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Height="34" Padding="6,0"
                                 VerticalContentAlignment="Center" Margin="0,0,0,18"/>

                    <Button x:Name="LoginButton" Content="Login" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="LoginButton_Click"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Hyperlink Click="Register_Click">Registration new account</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border x:Name="RegisterCard"
                    MaxWidth="340" Margin="32,0,32,0"
                    VerticalAlignment="Center"
                    Padding="28" Background="White" CornerRadius="12"
                    Visibility="Collapsed"> 
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Create account"
                   FontSize="20" FontWeight="SemiBold"
                   TextAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="Account" Margin="0,0,0,4"/>
                    <TextBox x:Name="RegUsernameTextBox" Height="34" Padding="6,0"
                 VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="RegPasswordBox" Height="34" Padding="6,0"
                     VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Confirm password" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="RegConfirmBox" Height="34" Padding="6,0"
                     VerticalContentAlignment="Center" Margin="0,0,0,18"/>

                    <Button x:Name="RegisterButton" Content="Register"
                Style="{StaticResource PrimaryButton}"
                Click="RegisterButton_Click"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0">
            <Hyperlink Click="BackToLogin_Click">Back to login</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>